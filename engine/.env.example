# Copy to .env and fill in real values. .env is gitignored and must NEVER be committed.
# This example file IS committed — keep only placeholders here, never real keys.

# --- Anthropic (the 1-pass synthesis agent; serve.py prefers this) ---
# With this set, serve.py runs mock-agent/server.py on the Messages API.
# Needs `pip install -r mock-agent/requirements.txt`. An `ant auth login`
# profile works instead of a key. Without either, the Claude Code CLI is used.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-opus-5   # default; or claude-sonnet-5 / claude-haiku-4-5

# --- LLM + embeddings (required for the engine pipeline) ---
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # NIM embeddings + chat
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx                               # optional, faster chat
CEREBRAS_API_KEY=csk-xxxxxxxxxxxxxxxxxxxx                           # optional, faster chat

# Optional: pick the chat model (see build.nvidia.com catalogue for current ids)
# BRIEF_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# --- Remote RAG store (optional; set RAG_STORE=qdrant to use it) ---
# Lets the code be shared without shipping the index/corpus — data lives in Qdrant.
# QDRANT_CLUSTER_ENDPOINT=https://<cluster-id>.<region>.aws.cloud.qdrant.io   # or QDRANT_URL
# QDRANT_API_KEY=xxxxxxxx                 # required for Qdrant Cloud; omit for self-hosted
# QDRANT_COLLECTION=napkin_rag            # optional (default)

# --- Claude (lead link and the independent critic) ---
# ANTHROPIC_API_KEY=
# BRIEF_PROVIDER=anthropic
# BRIEF_CLAUDE_TRANSPORT=api        # api | cli (Claude Code login) | auto (see ADR 0005)
# With Claude as the lead link the chain is Claude-only: no key and no `claude` CLI is a
# clear error, never a brief written by a NIM model. BRIEF_ALLOW_NONCLAUDE=1 restores the
# NIM fallback links (not for production; ADR 0006).
# BRIEF_ALLOW_NONCLAUDE=0

# --- RAG behaviour (defaults shown in engine/rag/README.md → Configuration) ---
# RAG_STORE=local
# RAG_VALIDATOR=jev            # briefs: jev by default when unset (Sai 2026-09-26); `none` = off
# TYPESAFE_API_KEY=            # needed for jev; without it a brief runs unvalidated and says so
# RAG_JEV_DEADLINE_S=8         # jev's own per-call deadline (ADR 0003 addendum)
# RAG_VALIDATION_MODE=order
# RAG_ORDER=score
