            ]
          }
        },
        "audience": {
          "description": "[gate: brief] The researched audience. A field backed by pinned facts, origin proposed or confirmed only.",
          "x-gate": "brief",
          "allOf": [
            {
              "$ref": "#/definitions/envelope"
            }
          ],
          "properties": {
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "definition"
              ],
              "properties": {
                "definition": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Who the research says the audience is, in one or two sentences."
                },
                "size": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "fact_ids"
                  ],
                  "properties": {
                    "fact_ids": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/definitions/fact_id"
                      }
                    },
                    "note": {
                      "type": "string"
                    }
                  },
                  "description": "Size is never a number here — it is the pins that measure it."
                },
                "behaviours": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/definitions/fact_backed_statement"
                  }
                },
                "attitudes": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/definitions/fact_backed_statement"
                  }
                },
                "synthesis_finding_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/definitions/finding_id"
                  },
                  "description": "Audience syntheses. Findings until verified; the view labels an unverified one 'derived by the agent'."
                }
              }
            },
            "gate": {
              "const": "brief"
            },
            "origin": {
              "enum": [
                "proposed",
                "confirmed"
              ]
            }
          },
          "propertyNames": {
            "enum": [
              "value",
              "origin",
              "gate",
              "source",
              "fact_ids",
              "finding_ids",
              "by",
              "confirmed_from",
