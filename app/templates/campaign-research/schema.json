    "selection": {
      "type": "object",
      "description": "Region C: what research drew on, what it looked for and did not find, and what clashed.",
      "additionalProperties": false,
      "properties": {
        "lenses_run": {
          "type": "array",
          "description": "One entry per lens x market run. Address key: <lens>/<market>.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lens",
              "market",
              "ran_at",
              "handler"
            ],
            "properties": {
              "lens": {
                "$ref": "#/definitions/lens"
              },
              "market": {
                "$ref": "#/definitions/market"
              },
              "ran_at": {
                "$ref": "#/definitions/datetime"
              },
              "handler": {
                "type": "string",
                "pattern": "^[a-z_]+@\\d+(\\.\\d+)?$"
              },
              "decision": {
                "$ref": "#/definitions/decision_id"
              }
            }
          }
        },
        "coverage": {
          "type": "object",
          "description": "Merged coverage per lens across markets. filled = corroborated, thin = single-source, empty = nothing found. Merged: filled only if filled in every market, empty only if empty in every market, otherwise thin.",
          "propertyNames": {
            "enum": [
              "market_structure",
              "brands_positioning",
              "consumer_culture",
              "category_codes",
              "rhythm_moments",
              "media_spend",
              "regulation_clearance",
              "effectiveness_evidence"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "filled",
              "thin",
              "empty"
            ]
          }
        },
        "coverage_by_market": {
          "type": "object",
          "description": "The per-market coverage the merged map was computed from.",
          "propertyNames": {
            "pattern": "^[A-Z]{2}$"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "market_structure",
                "brands_positioning",
                "consumer_culture",
                "category_codes",
                "rhythm_moments",
                "media_spend",
                "regulation_clearance",
                "effectiveness_evidence"
              ]
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "filled",
                "thin",
                "empty"
              ]
            }
          }
        },
        "gaps": {
          "type": "array",
          "description": "What was looked for and not found. Address key: id.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "key",
              "searched",
              "sources_tried"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/item_key"
              },
              "key": {
                "type": "string",
                "description": "<entity>:<fact key>, the fact that was wanted."
              },
              "lens": {
                "$ref": "#/definitions/lens"
              },
              "market": {
                "$ref": "#/definitions/market"
              },
              "searched": {
                "type": "string",
                "minLength": 1,
                "description": "What was looked for, in words."
              },
              "sources_tried": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "contested": {
          "type": "array",
          "description": "Two writers, one fact identity, different values. Resolved entries stay; the losing values stay with the written reason. Must hold no open entry at lock. Address key: id.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "key",
              "status",
              "values"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/item_key"
              },
              "key": {
                "type": "string",
                "description": "<entity>:<fact key>[@<market>]"
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "resolved"
                ]
              },
              "values": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "value",
                    "fact_id",
                    "from"
                  ],
                  "properties": {
                    "value": {
                      "type": [
                        "number",
                        "string",
                        "boolean"
                      ]
                    },
                    "unit": {
                      "type": "string"
                    },
                    "fact_id": {
                      "$ref": "#/definitions/fact_id"
                    },
                    "from": {
                      "type": "string",
                      "description": "Which writer produced it: <lens>/<market>, a source id, or an actor."
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "chosen": {
                "$ref": "#/definitions/fact_id"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "decided_by": {
                "$ref": "#/definitions/decision_id"
              },
              "opened_by": {
                "$ref": "#/definitions/decision_id"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "resolved"
                    }
                  }
                },
                "then": {
                  "required": [
                    "chosen",
                    "reason",
                    "decided_by"
                  ]
                },
                "else": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "chosen"
                        ]
                      },
                      {
                        "required": [
                          "decided_by"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        "excluded": {
          "type": "array",
          "description": "Facts research found and deliberately did not pin. Address key: fact_id.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fact_id",
              "reason"
            ],
            "properties": {
              "fact_id": {
                "$ref": "#/definitions/fact_id"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "$ref": "#/definitions/decision_id"
              }
            }
          }
        }
      }
    },
    "materials": {
      "type": "object",
      "description": "Supplied material, keyed by material id: the prompt and every attachment. Bytes live as assets by hash; this is the index spans cite.",
      "propertyNames": {
        "pattern": "^mat_[0-9A-Za-z]{4,}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "name",
          "sha256",
          "received_at",
          "licence"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "prompt",
              "client_brief",
              "email",
              "deck",
              "research",
              "other"
            ]
          },
          "name": {
            "type": "string"
          },
          "sha256": {
            "$ref": "#/definitions/sha256"
          },
          "media_type": {
            "type": "string"
          },
          "asset": {
            "type": "string",
            "description": "Asset path inside the document, when the bytes travel in it."
          },
          "received_at": {
            "$ref": "#/definitions/datetime"
          },
          "licence": {
            "type": "string",
            "enum": [
              "open",
              "licensed-internal",
              "client-confidential"
            ],
            "description": "Facts derived from client-confidential material carry the brand licence class and never promote (C3)."
          }
        }
      }
    },
    "projection": {
      "type": "object",
      "description": "HOST-WRITTEN, READ-ONLY (decision D2). A scalar projection of shared/facts.yaml and shared/findings.yaml so view bindings resolve against shared/data.yaml alone. Rebuilt by the host after every change to either member; no agent or human patch may write it; the members are the authority. If built_from does not match the members' hashes the view says so instead of rendering the projection as current.",
      "additionalProperties": false,
      "required": [
        "built_from",
        "pins",
        "findings"
      ],
      "properties": {
        "built_from": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "facts_sha256",
            "findings_sha256",
            "built_at"
          ],
          "properties": {
            "facts_sha256": {
              "$ref": "#/definitions/sha256"
            },
            "findings_sha256": {
              "$ref": "#/definitions/sha256"
            },
            "built_at": {
              "$ref": "#/definitions/datetime"
            }
          }
        },
        "pins": {
          "type": "object",
          "propertyNames": {
            "pattern": "^f_[0-9A-Z]{6,}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "layer",
              "entity",
              "key",
              "value",
              "unit",
              "as_of",
              "confidence",
              "licence",
              "stale"
            ],
            "properties": {
              "layer": {
                "type": "string",
                "enum": [
                  "brand",
                  "category"
                ]
              },
              "entity": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "market": {
                "$ref": "#/definitions/market"
              },
              "value": {
                "type": [
                  "number",
                  "string",
                  "boolean"
                ]
              },
              "unit": {
                "type": "string"
              },
              "as_of": {
                "$ref": "#/definitions/date"
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "licence": {
                "type": "string",
                "enum": [
                  "open",
                  "licensed-internal",
                  "client-confidential"
                ]
              },
              "method": {
                "type": "string"
              },
              "stale": {
                "type": "boolean"
              },
              "current_version": {
                "type": "integer",
                "minimum": 1
              },
              "retrieved_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^(src_[0-9a-z]{4,}|human:.+|f_[0-9A-Z]{6,})$",
                  "description": "Source ids, a human:<id> verification, or — for method: synthesis — the fact ids it rests on"
                }
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "active",
                  "contested"
                ],
                "description": "The layer row's status when pinned. Frozen with the value."
              },
              "pin_reason": {
                "type": "string",
                "minLength": 1
              },
              "current_value": {
                "type": [
                  "number",
                  "string",
                  "boolean"
                ],
                "description": "For a stale pin only: the value of the current layer version, offered, never swapped in."
              }
            }
          }
        },
        "findings": {
          "type": "object",
          "propertyNames": {
            "pattern": "^fi_[0-9A-Z]{6,}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "statement",
              "status",
              "confidence",
              "cites"
            ],
            "properties": {
              "statement": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "proposed",
                  "verified",
                  "rejected"
                ]
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "cites": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/fact_id"
                }
              },
              "fact_id": {
                "$ref": "#/definitions/fact_id"
              }
            }
          }
        }
      }
    }
  }
}
