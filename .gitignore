.DS_Store
.agents/
.claude/
*.clan.bak
*.tmp
.env
target/
target-gnu/

# Editor autosave / lock / swap files (Emacs #file#, *~, .#file; Vim *.swp)
\#*\#
*~
.\#*
*.swp

# Cargo.lock is committed: this workspace builds binaries (clan-cli) and the
# Tauri app, and the release pipeline needs reproducible dependency versions.
# (Floating deps previously pulled a broken `time` release and failed CI.)

# CLI sidecar staged into the viewer MSI during the release build (see release.yml).
app/src-tauri/binaries/

# Generated by CI conformance harness — uploaded as a workflow artifact
conformance.json
.napkin-dev-signing-key
app/src-tauri/.napkin-dev-signing-key
__pycache__/

# Handoff bundles built by package-handoff.sh — regenerate, never commit.
/dist/

# napkin-web's default data root when run from a checkout.
/napkin-web-data/

# Local Python venv for the Anthropic SDK (the agent backend).
.venv/

# Generated by `npm run wasm` from crates/napkin-wasm. The binary and its glue
# are build output; the .d.ts is committed so a clean checkout can type-check
# the wasm host without a Rust toolchain — and so a change to the Rust API
# shows up as a diff rather than as a surprise at build time.
app/src/wasm/*
!app/src/wasm/napkin_wasm.d.ts

# Templates packaged by `npm run apps` from app/templates/ — build output.
app/public/apps/
