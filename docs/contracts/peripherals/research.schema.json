{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "napkin.research/1",
  "title": "Research port — napkin.research/1 (docs/contracts/peripherals.md §2)",
  "definitions": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "lens": { "type": "string", "enum": ["market_structure", "brands_positioning", "consumer_culture", "category_codes", "rhythm_moments", "media_spend", "regulation_clearance", "effectiveness_evidence"] },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "lens", "market"],
      "properties": {
        "query": { "type": "string", "minLength": 1, "maxLength": 500 },
        "lens": { "$ref": "#/definitions/lens" },
        "market": { "type": "string", "pattern": "^[A-Za-z]{2}$", "not": { "enum": ["UK", "uk", "Uk", "uK"] } },
        "entity": { "type": "string", "pattern": "^(brand|org|category)/[a-z0-9][a-z0-9._-]*$" },
        "category": { "type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$" },
        "max_sources": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "publisher", "title", "retrieved_at", "excerpts"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "A handle within this response; the layers assign the stored id." },
        "url": { "type": "string", "pattern": "^https?://[^/#\\s]+[^#\\s]*$" },
        "publisher": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "retrieved_at": { "$ref": "#/definitions/date" },
        "published_at": { "anyOf": [{ "$ref": "#/definitions/date" }, { "type": "null" }] },
        "excerpts": {
          "type": "array", "minItems": 1, "maxItems": 5,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["quote"],
            "properties": { "quote": { "type": "string", "minLength": 1, "maxLength": 1500 } }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "trace"],
      "properties": {
        "sources": { "type": "array", "maxItems": 20, "items": { "$ref": "#/definitions/source" } },
        "trace": {
          "type": "object",
          "required": ["backend"],
          "properties": {
            "backend": { "type": "string", "minLength": 1 },
            "queries": { "type": "array", "items": { "type": "string" } },
            "model": { "type": "string" }
          }
        }
      }
    }
  }
}
